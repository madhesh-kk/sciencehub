# Frontend Environment Configuration
# Copy this file to .env.local and update with actual values

# API Base URL - points to the backend server
VITE_API_BASE_URL=http://localhost:8085/api

# App mode
VITE_NODE_ENV=development

# Razorpay Configuration (for payment processing)
VITE_RAZORPAY_KEY=your_razorpay_key_here

# Optional: Analytics or tracking
# VITE_ANALYTICS_ID=your_analytics_id_here
