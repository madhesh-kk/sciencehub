# Backend Environment Configuration
# Copy this file to .env.local and update with actual values

# Server Configuration
SERVER_PORT=8085
SERVER_HOST=0.0.0.0

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/minilabdb
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_password_here
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Configuration (if using JWT for auth)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Razorpay Configuration (if using Razorpay for payments)
RAZORPAY_KEY_ID=your_razorpay_key_here
RAZORPAY_SECRET_KEY=your_razorpay_secret_here

# Logging
LOGGING_LEVEL=INFO
